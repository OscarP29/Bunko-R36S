{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R36S Manager",
  "version": "0.1.0",
  "identifier": "com.r36s.manager",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "R36S Manager", "width": 1440, "height": 920, "minWidth": 1080, "minHeight": 720 }], "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
